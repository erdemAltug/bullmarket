# Public site URL (canonical / OG / sitemap)
NEXT_PUBLIC_SITE_URL="https://bullsye.app"

# Neon PostgreSQL (required for Drizzle)
DATABASE_URL="postgresql://user:password@ep-your-neon-endpoint.neon.tech/neondb?sslmode=require"

# Anonymous fallback until login
DEFAULT_USER_ID="local-dev-user"

# Neon Auth (Managed Better Auth)
NEON_AUTH_URL="https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth"
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth"
NEON_JWKS_URL="https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth/.well-known/jwks.json"
# openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET="replace-with-32-plus-char-secret-value-here"

# Microsoft Clarity (session replay / heatmaps)
NEXT_PUBLIC_CLARITY_PROJECT_ID="your-clarity-project-id"

# Resend (alarm + sabah özeti e-postası)
RESEND_API_KEY=
RESEND_FROM=
# Sabah özeti cron (GitHub Actions secret ile aynı); openssl rand -hex 32
CRON_SECRET=

# Google Ads (reklam dönüşüm takibi) — AW-XXXXXXXXX ve kayıt dönüşüm etiketi
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=
# Yeni Pro talebi bildirimi gidecek adres (opsiyonel)
PRO_LEADS_EMAIL=
